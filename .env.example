# ==========================================
# SMART UNIVERSITY - ENVIRONMENT CONFIGURATION
# ==========================================

# Backend Server Port
PORT=5000
NODE_ENV=development

# Supabase Credentials (PostgreSQL & Auth)
# If not yet created, leave blank - the application will automatically run in full interactive Demo Mode!
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Assistant Integration (Google Gemini API)
# If left empty, the built-in Intelligent University Knowledge AI answers queries with university context!
GEMINI_API_KEY=your-gemini-api-key
