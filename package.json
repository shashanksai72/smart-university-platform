{
  "name": "smart-university-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Smart University - Digital Transformation Platform",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "node start-dev.js",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "build": "npm --prefix client install && npm --prefix client run build && node -e \"const fs=require('fs'); fs.cpSync('client/dist', 'dist', {recursive:true});\"",
    "start": "npm --prefix server run start"
  },
  "keywords": [
    "smart-university",
    "digital-transformation",
    "react",
    "typescript",
    "express",
    "supabase"
  ],
  "author": "Smart University Ecosystem",
  "license": "MIT"
}
